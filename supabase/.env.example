# Local development only. Copy to supabase/.env (git-ignored) before `supabase start`.
# Real environments take these from GCP Secret Manager (docs/plan/infra-cicd.md §4).

# Send SMS Hook secret shared by Auth and the auth-send-sms function: "v1,whsec_" + base64 of
# 32 random bytes. Generate one with:
#   node -e "console.log('v1,whsec_' + require('crypto').randomBytes(32).toString('base64'))"
SEND_SMS_HOOK_SECRETS=v1,whsec_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# development | staging | production. The console SMS provider refuses to run in production.
SUSKII_ENV=development

# Optional: Android SMS Retriever app hash appended to OTP messages for autofill.
ANDROID_SMS_RETRIEVER_HASH=

# Optional: error reporting for Edge Functions.
SENTRY_DSN=
SUSKII_RELEASE=local

# Optional: Play Integrity decoding (device-integrity function).
ANDROID_PACKAGE_NAME=
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT=

# Optional: iOS App Attest (device-integrity function). IOS_APP_ID is <team id>.<bundle id>.
# APP_ATTEST_ENVIRONMENT matches the app's appattest-environment entitlement (development|production).
# APP_ATTEST_VALIDATION_CATEGORIES defaults to 4 (App Store) in production, 2,3,4 in development.
IOS_APP_ID=
APP_ATTEST_ENVIRONMENT=development
APP_ATTEST_VALIDATION_CATEGORIES=
