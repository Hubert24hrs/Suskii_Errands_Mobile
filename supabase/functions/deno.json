{
  "workspace": [
    "./auth-send-sms",
    "./device-integrity",
    "./health"
  ],
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "standardwebhooks": "npm:standardwebhooks@1.1.1",
    "jose": "npm:jose@6.2.12",
    "@sentry/deno": "npm:@sentry/deno@10.74.0"
  },
  "fmt": {
    "lineWidth": 120
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
