// Per-environment build settings (ADR-0015). Defaults are dev; the values for the build in
// hand are written to DartDefines.xcconfig from the --dart-define-from-file file, by the
// Runner scheme's pre-action locally and by tool/write_ios_defines.sh in the release workflow.
APP_DISPLAY_NAME = Suskii Errands
APP_ID_SUFFIX = .dev
APP_LINK_HOST = dev.suskii-errands.example
// Google sign-in's callback URL scheme: the iOS OAuth client ID reversed. A placeholder until
// the define file carries the real one (it is a public identifier, not a secret).
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.not-configured
// Google Maps SDK key; empty until a build injects it (AppConfig.hasMaps).
GOOGLE_MAPS_API_KEY =
#include? "DartDefines.xcconfig"
