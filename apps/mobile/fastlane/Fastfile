# Store releases for Suskii Errands (docs/runbooks/RB-15-store-release.md).
#
#   bundle exec fastlane android release env:prod track:internal   # build + upload
#   bundle exec fastlane android build env:prod                    # signed bundle only
#   bundle exec fastlane ios release env:prod                      # archive + TestFlight
#   bundle exec fastlane ios archive env:prod                      # signed .ipa only
#   bundle exec fastlane android metadata          # listing text only
#   bundle exec fastlane ios metadata
#
# Run from apps/mobile. Every credential comes from the environment, which the release
# workflow (.github/workflows/mobile-release.yaml) fills from repository secrets; nothing in
# this directory, or anywhere in the repository, is a key.

default_platform(:android)

APP_ID = "com.suskiierrands.app"
ROOT = File.expand_path("..", __dir__)
ENVIRONMENTS = %w[dev staging prod].freeze

# The release workflow writes build/env/<env>.json: config/env/<env>.json with the secrets
# (Supabase URL and anon key, Sentry DSN) merged in. Locally the committed file is used.
def define_file(env)
  UI.user_error!("env must be one of #{ENVIRONMENTS.join(', ')}") unless ENVIRONMENTS.include?(env)
  generated = File.join(ROOT, "build", "env", "#{env}.json")
  File.exist?(generated) ? generated : File.join(ROOT, "config", "env", "#{env}.json")
end

def app_id_for(env)
  env == "prod" ? APP_ID : "#{APP_ID}.#{env}"
end

# Store build numbers only ever go up. The workflow derives one from the run number; a local
# release must pass one explicitly rather than reuse pubspec's.
def build_number
  ENV["BUILD_NUMBER"].to_s.empty? ? UI.user_error!("Set BUILD_NUMBER") : ENV["BUILD_NUMBER"]
end

def require_env(*names)
  missing = names.select { |n| ENV[n].to_s.empty? }
  UI.user_error!("Missing #{missing.join(', ')} (RB-15 lists where each comes from)") unless missing.empty?
end

platform :android do
  desc "Build the signed release App Bundle (needs android/key.properties)"
  lane :build do |options|
    env = options.fetch(:env, "prod").to_s
    UI.user_error!("android/key.properties is missing: Play refuses a debug-signed bundle") unless
      File.exist?(File.join(ROOT, "android", "key.properties"))
    Dir.chdir(ROOT) do
      sh("flutter", "build", "appbundle", "--release",
         "--dart-define-from-file=#{define_file(env)}",
         "--build-number=#{build_number}",
         "--obfuscate", "--split-debug-info=build/symbols/android")
    end
  end

  desc "Upload the bundle `build` produced to a Play track (internal by default)"
  lane :upload do |options|
    env = options.fetch(:env, "prod").to_s
    track = options.fetch(:track, "internal").to_s
    require_env("PLAY_SERVICE_ACCOUNT_JSON")
    upload_to_play_store(
      package_name: app_id_for(env),
      track: track,
      aab: File.join(ROOT, "build/app/outputs/bundle/release/app-release.aab"),
      mapping: File.join(ROOT, "build/app/outputs/mapping/release/mapping.txt"),
      json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"],
      # Production goes up as a draft: a person rolls it out from Play Console.
      release_status: track == "production" ? "draft" : "completed",
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      metadata_path: File.join(__dir__, "metadata", "android"),
    )
  end

  desc "Build and upload: `build` then `upload`"
  lane :release do |options|
    build(options)
    upload(options)
  end

  desc "Upload the listing text in fastlane/metadata/android (no binary)"
  lane :metadata do |options|
    require_env("PLAY_SERVICE_ACCOUNT_JSON")
    upload_to_play_store(
      package_name: app_id_for(options.fetch(:env, "prod").to_s),
      json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"],
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      metadata_path: File.join(__dir__, "metadata", "android"),
    )
  end
end

platform :ios do
  # Signing is Xcode's automatic signing driven by an App Store Connect API key: no
  # certificates or profiles to store as secrets, and none in the repository.
  def asc_auth_args
    require_env("ASC_KEY_ID", "ASC_ISSUER_ID", "ASC_KEY_P8", "APPLE_TEAM_ID")
    key_path = File.join(ROOT, "build", "asc", "AuthKey_#{ENV['ASC_KEY_ID']}.p8")
    FileUtils.mkdir_p(File.dirname(key_path))
    File.write(key_path, ENV["ASC_KEY_P8"])
    File.chmod(0o600, key_path)
    "-allowProvisioningUpdates -authenticationKeyPath #{key_path} " \
      "-authenticationKeyID #{ENV['ASC_KEY_ID']} -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
  end

  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
    )
  end

  desc "Archive and sign an App Store build into build/ios/ipa"
  lane :archive do |options|
    env = options.fetch(:env, "prod").to_s
    auth = asc_auth_args

    Dir.chdir(ROOT) do
      sh("tool/write_ios_defines.sh", define_file(env))
      # Writes Generated.xcconfig (defines, build number, obfuscation) without compiling;
      # the archive below compiles the Dart code with exactly those settings.
      sh("flutter", "build", "ios", "--config-only", "--release",
         "--dart-define-from-file=#{define_file(env)}",
         "--build-number=#{build_number}",
         "--obfuscate", "--split-debug-info=build/symbols/ios")
    end

    build_app(
      workspace: File.join(ROOT, "ios", "Runner.xcworkspace"),
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(ROOT, "build", "ios", "ipa"),
      xcargs: "#{auth} DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} CODE_SIGN_STYLE=Automatic",
      export_xcargs: auth,
    )
  ensure
    FileUtils.rm_rf(File.join(ROOT, "build", "asc"))
  end

  desc "Archive, then upload the build to TestFlight"
  lane :release do |options|
    archive(options)
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: Dir[File.join(ROOT, "build", "ios", "ipa", "*.ipa")].first,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Upload the listing text in fastlane/metadata/ios (no binary, no screenshots)"
  lane :metadata do
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      metadata_path: File.join(__dir__, "metadata", "ios"),
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
    )
  end
end
