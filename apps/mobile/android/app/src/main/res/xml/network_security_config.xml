<?xml version="1.0" encoding="utf-8"?>
<!-- Staging and production: HTTPS only, system CAs only. A user-installed CA (a corporate or
     debugging proxy) cannot read the traffic, which carries session tokens and payment state. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
