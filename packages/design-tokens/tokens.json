{
  "$schema": "Mirrors packages/suskii_design/lib/src/tokens/ — edit both together. `node build-css.mjs` regenerates tokens.css.",
  "meta": {
    "version": "2.0.0",
    "name": "Aurora (placeholder brand)",
    "note": "Dark-first. Every text/surface pair clears WCAG AA; suskii_design's design_tokens_test.dart checks them."
  },
  "color": {
    "brand": {
      "primary": "#087A5B",
      "primaryStrong": "#065E46",
      "onPrimary": "#FFFFFF",
      "secondary": "#5A44E0",
      "onSecondary": "#FFFFFF",
      "dark": {
        "primary": "#35E6B0",
        "primaryStrong": "#2BC896",
        "onPrimary": "#02170F",
        "secondary": "#9A8CFF",
        "onSecondary": "#140B45"
      },
      "gradient": {
        "light": ["#087A5B", "#1A6FC0", "#5A44E0"],
        "dark": ["#35E6B0", "#3FB8FF", "#9A8CFF"]
      },
      "onGradient": { "light": "#FFFFFF", "dark": "#02170F" }
    },
    "semantic": {
      "light": {
        "success": "#127A48",
        "warning": "#8A5800",
        "error": "#C12D3B",
        "info": "#1760C4"
      },
      "dark": {
        "success": "#4ADE9B",
        "warning": "#FFC14D",
        "error": "#FF7C88",
        "info": "#6EBBFF"
      }
    },
    "surface": {
      "light": {
        "background": "#F4F6FB",
        "surface": "#F7F9FD",
        "surfaceRaised": "#FFFFFF",
        "surfaceMuted": "#ECF0F7",
        "surfaceHigh": "#E3E9F3",
        "textPrimary": "#0A1020",
        "textSecondary": "#475470",
        "outline": "#77849E",
        "outlineVariant": "#D7DEEA",
        "glass": "rgba(255, 255, 255, 0.80)",
        "glassBorder": "rgba(10, 16, 32, 0.10)"
      },
      "dark": {
        "background": "#070B14",
        "surface": "#0B1120",
        "surfaceRaised": "#111A2C",
        "surfaceMuted": "#18223A",
        "surfaceHigh": "#1F2B45",
        "textPrimary": "#EEF2FB",
        "textSecondary": "#A6B1C9",
        "outline": "#63739A",
        "outlineVariant": "#2C3A57",
        "glass": "rgba(17, 26, 44, 0.72)",
        "glassBorder": "rgba(255, 255, 255, 0.20)"
      }
    }
  },
  "spacing": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "gutter": 20,
    "xl": 24,
    "xxl": 32,
    "xxxl": 48,
    "xxxxl": 64,
    "minTouchTarget": 48
  },
  "radius": {
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "pill": 999
  },
  "blur": {
    "glass": 24,
    "heavy": 40
  },
  "typography": {
    "fontFamily": "Manrope, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "displayFontFamily": "Sora, Manrope, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "displayLarge": { "size": 48, "weight": 700, "lineHeight": 1.08 },
    "displaySmall": { "size": 34, "weight": 700, "lineHeight": 1.12 },
    "headlineLarge": { "size": 30, "weight": 700, "lineHeight": 1.18 },
    "headlineMedium": { "size": 26, "weight": 700, "lineHeight": 1.2 },
    "headlineSmall": { "size": 22, "weight": 600, "lineHeight": 1.25 },
    "titleLarge": { "size": 19, "weight": 600, "lineHeight": 1.3 },
    "titleMedium": { "size": 16, "weight": 700, "lineHeight": 1.35 },
    "bodyLarge": { "size": 16, "weight": 500, "lineHeight": 1.5 },
    "bodyMedium": { "size": 14, "weight": 500, "lineHeight": 1.45 },
    "bodySmall": { "size": 12.5, "weight": 500, "lineHeight": 1.4 },
    "labelLarge": { "size": 15, "weight": 700, "lineHeight": 1.25 },
    "labelSmall": { "size": 11.5, "weight": 700, "lineHeight": 1.3 }
  },
  "motion": {
    "duration": {
      "instant": 90,
      "fast": 160,
      "normal": 260,
      "slow": 420,
      "page": 380,
      "shellSwitch": 320
    },
    "easing": {
      "standard": "cubic-bezier(0.33, 1, 0.68, 1)",
      "emphasized": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "decelerate": "cubic-bezier(0.25, 1, 0.5, 1)"
    }
  }
}
