{
  "$schema": "Mirrors packages/suskii_design/lib/src/tokens/ — edit both together",
  "color": {
    "brand": {
      "primary": "#0E7C66",
      "primaryStrong": "#0A5A4B",
      "onPrimary": "#FFFFFF",
      "secondary": "#F4A259",
      "onSecondary": "#3A2200"
    },
    "semantic": {
      "light": {
        "success": "#1B7F3B",
        "warning": "#9A6700",
        "error": "#B3261E",
        "info": "#0B5CAD"
      },
      "dark": {
        "success": "#6FD38A",
        "warning": "#F2C14E",
        "error": "#F2B8B5",
        "info": "#9CC3F2"
      }
    },
    "surface": {
      "light": {
        "surface": "#FDFDFC",
        "surfaceRaised": "#FFFFFF",
        "surfaceMuted": "#F1F3F2",
        "textPrimary": "#15211D",
        "textSecondary": "#4A5A54",
        "outline": "#C7D0CC"
      },
      "dark": {
        "surface": "#101614",
        "surfaceRaised": "#18201D",
        "surfaceMuted": "#212B27",
        "textPrimary": "#EAF1EE",
        "textSecondary": "#AAB8B2",
        "outline": "#3A4742"
      }
    }
  },
  "spacing": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "xxxl": 48,
    "minTouchTarget": 48
  },
  "radius": {
    "sm": 6,
    "md": 12,
    "lg": 20,
    "pill": 999
  },
  "typography": {
    "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "displaySmall": { "size": 34, "weight": 700, "lineHeight": 1.2 },
    "headlineMedium": { "size": 26, "weight": 700, "lineHeight": 1.25 },
    "headlineSmall": { "size": 22, "weight": 600, "lineHeight": 1.3 },
    "titleLarge": { "size": 18, "weight": 600, "lineHeight": 1.35 },
    "titleMedium": { "size": 16, "weight": 600, "lineHeight": 1.4 },
    "bodyLarge": { "size": 16, "weight": 400, "lineHeight": 1.5 },
    "bodyMedium": { "size": 14, "weight": 400, "lineHeight": 1.45 },
    "bodySmall": { "size": 12, "weight": 400, "lineHeight": 1.4 },
    "labelLarge": { "size": 14, "weight": 600, "lineHeight": 1.3 },
    "labelSmall": { "size": 11, "weight": 500, "lineHeight": 1.3 }
  },
  "motion": {
    "duration": {
      "fast": 150,
      "normal": 250,
      "slow": 400,
      "shellSwitch": 300
    },
    "easing": {
      "standard": "cubic-bezier(0.33, 1, 0.68, 1)",
      "emphasized": "cubic-bezier(0.05, 0, 0, 1)"
    }
  }
}
